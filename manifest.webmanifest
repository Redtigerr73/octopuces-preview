{
  "name": "Etiket — OctoPuces",
  "short_name": "Etiket",
  "description": "Stock, annonces, clients, ventes et compta d'une boutique de meubles d'occasion (démo).",
  "lang": "fr-BE",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#172126",
  "theme_color": "#172126",
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "shot", "accept": ["image/*"] }] }
  }
}
